# Copy this file to `.env` in the project root and fill in your values.
# The app loads this file automatically via python-dotenv.

# Required only for GPT-powered natural language explanations.
# Without it, the app falls back to rule-based explanations.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the default model used for explanations.
# OPENAI_MODEL=gpt-4o-mini
